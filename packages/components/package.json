{
  "name": "@stylewx/components",
  "version": "0.2.0",
  "description": "stylewx rich component library: Markdown directive syntax (:::card / :::gallery / :::carousel …) compiled to WeChat-safe inline-style HTML + SVG/SMIL interactions. Isomorphic (no DOM / no Node-only APIs).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@stylewx/theme": "workspace:*",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
