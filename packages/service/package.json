{
  "name": "@mp-style/service",
  "version": "0.1.0",
  "private": true,
  "description": "mp-style shared service layer: composes core/theme/validator/publisher/preview into the 6 high-level operations reused by both MCP Server and REST API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mp-style/core": "workspace:*",
    "@mp-style/preview": "workspace:*",
    "@mp-style/publisher": "workspace:*",
    "@mp-style/theme": "workspace:*",
    "@mp-style/validator": "workspace:*",
    "zod": "^4.0.0"
  }
}
