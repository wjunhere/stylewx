{
  "name": "@stylewx/service",
  "version": "0.1.0",
  "description": "stylewx shared service layer: composes core/theme/validator/publisher/preview into the 6 high-level operations reused by both MCP Server and REST API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@stylewx/core": "workspace:*",
    "@stylewx/preview": "workspace:*",
    "@stylewx/publisher": "workspace:*",
    "@stylewx/theme": "workspace:*",
    "@stylewx/validator": "workspace:*",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
