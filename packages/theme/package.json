{
  "name": "@stylewx/theme",
  "version": "0.2.2",
  "description": "stylewx theme package: zod theme schema (with JSON Schema export), WeChat-safe CSS whitelist, theme → CSS compiler, and preset themes (6 built-in + 20 WeMD ported). Isomorphic (no DOM / no Node-only APIs).",
  "keywords": [
    "wechat",
    "wechat-article",
    "markdown",
    "theme",
    "typography",
    "微信公众号"
  ],
  "license": "MIT",
  "author": {
    "name": "wjunhere",
    "url": "https://github.com/wjunhere"
  },
  "homepage": "https://github.com/wjunhere/stylewx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjunhere/stylewx.git",
    "directory": "packages/theme"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
