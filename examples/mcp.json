{
  "mcpServers": {
    "mp-style": {
      "command": "node",
      "args": [
        "<repo>/apps/mcp-server/dist/index.js",
        "--transport",
        "stdio"
      ],
      "env": {
        "WECHAT_APP_ID": "你的公众号AppID",
        "WECHAT_APP_SECRET": "你的公众号AppSecret",
        "LLM_BASE_URL": "https://api.openai.com/v1",
        "LLM_API_KEY": "你的LLM API Key",
        "LLM_MODEL": "gpt-4o-mini"
      }
    }
  }
}
