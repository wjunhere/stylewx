# ===== stylewx 环境变量 =====
# 复制到**工作区**（不是仓库）并填真实值：`<workspace>/.env`。
# 所有凭据只从环境读取，绝不写入代码/仓库。
#
# ⚠️ 仓库只放代码：文章、品牌图源（头/尾图、logo）、本机产物都在工作区里。
# 默认工作区是与仓库同级的 ../stylewx-workspace，用 STYLEWX_WORKSPACE 指过去。

# ---- 工作区（私人产物都在这里，见 assets-src/paths.mjs）----
STYLEWX_WORKSPACE=B:/stylewx-workspace

# ---- 微信公众号（publish_draft 需要）----
# 公众号 AppID / AppSecret（在 公众平台 → 开发 → 基本配置 获取）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 可选：微信 API 基地址（默认 https://api.weixin.qq.com）
WECHAT_API_BASE=https://api.weixin.qq.com

# ---- LLM（generate_theme 需要）----
# OpenAI 兼容接口地址。opencode go 用 https://opencode.ai/zen/go/v1（需 LLM_API_STYLE=responses）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 端点风格：chat=/chat/completions（默认）；responses=/responses（opencode go 用）
LLM_API_STYLE=chat

# ---- REST API ----
# API 监听端口（默认 3001）
PORT=3001

# ---- 探针夹具（仅手动探针用）----
# apps/mcp-server/scripts/probe-wechat-widget-survival.mjs 用**真实**标签做存活验证，
# 而昵称/头像/视频号 id 属于账号数据 —— 不写进仓库，只写在这里（工作区 .env）。
# 昵称写朴素形式（如 `某某 青年`），脚本自己按微信的规矩规范化成 &nbsp;。
# STYLEWX_ACCOUNT_NICKNAME=某某 青年
# STYLEWX_ACCOUNT_HEADIMG=https://wx.qlogo.cn/...
# STYLEWX_ACCOUNT_FINDER=v2_...@finder
# STYLEWX_PROBE_MUSIC_NAME=某首歌

# ---- 文章目录 ----
# 默认 $STYLEWX_WORKSPACE/articles。stylewx-editor.bat 已默认指好，通常不用设。
# STYLEWX_ARTICLES_DIR=B:\stylewx-workspace\articles

# ---- 品牌图源（头/尾图、logo 的 SVG 源）----
# 默认 $STYLEWX_WORKSPACE/brand/motion；定稿副本用 STYLEWX_BRAND_MOTION_SHIPPED_DIR。
# STYLEWX_BRAND_ASSETS_DIR=B:\stylewx-workspace\brand\motion
