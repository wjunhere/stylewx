# dependencies
node_modules/

# build output
dist/
build/
.turbo/

# test / coverage
coverage/
*.tsbuildinfo

# env / secrets — never commit credentials
.env
.env.local
.env.*
!.env.example
!**/.env.example

# logs & OS
*.log
.DS_Store
Thumbs.db

# playwright
playwright-report/
test-results/
apps/mcp-server/.preview/
*.png.tmp

# pi agent harness state
.pi/

# browser evidence screenshot artifact
packages/preview/*.png

# 本机排版输出（生成物，不提交）
text_one_out/
examples/showcase-out/
examples/handoff-out/

# 本机文章工作区：原文、排版成品、封面图。都是本机产生的而不是库的一部分。
# 启动器（stylewx-editor.bat）会把 STYLEWX_ARTICLES_DIR 指到这个目录，
# 所以文章一律放 articles/，别再散落在仓根。
articles/

# 移植脚本的上游缓存（scripts/port-wemd-themes.mjs 用）
.cache/

# 对比实验的截图/渲染产物（体积大，本机复现：node scripts/comparison/run.mjs）
scripts/comparison/output/
