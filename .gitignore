# dependencies
node_modules/

# build output
dist/
build/
.turbo/

# test / coverage
coverage/
*.tsbuildinfo

# env / secrets — never commit credentials
.env
.env.local
.env.*
!.env.example
!**/.env.example

# logs & OS
*.log
.DS_Store
Thumbs.db

# playwright
playwright-report/
test-results/
apps/mcp-server/.preview/
*.png.tmp

# pi agent harness state
.pi/

# browser evidence screenshot artifact
packages/preview/*.png

# 本机排版输出（生成物，不提交）
text_one_out/
examples/showcase-out/
examples/handoff-out/

# 发布产物校验（pnpm check:pack 的 tarball 落地目录）
pack-out/

# 本机文章工作区：原文、排版成品、封面图。都是本机产生的而不是库的一部分。
# 启动器（stylewx-editor.bat）会把 STYLEWX_ARTICLES_DIR 指到这个目录，
# 所以文章一律放 articles/，别再散落在仓根。
articles/

# Hippie 文章的渲染产物（2.5MB 的 390px 截图 + HTML），本机复现：
#   node assets-src/review-hippie.mjs        （整篇校验 + 截图）
#   node assets-src/review-shot.mjs <文章>    （单篇终态截图）
# 生成器入仓（assets-src/gen-hippie-covers.mjs），产物不入仓。
# ⚠️ articles/hippie/originals/ 是**人的初版快照**，在已被忽略的 articles/ 里 ——
#    换机器时必须手动拷贝，否则踩 AGENTS.md 铁律⑧（误删后无处回灌）。
docs/assets/hippie-articles/

# 移植脚本的上游缓存（scripts/port-wemd-themes.mjs 用）
.cache/

# 对比实验的截图/渲染产物（体积大，本机复现：node scripts/comparison/run.mjs）
scripts/comparison/output/

# 本机 npm 2FA 恢复码（凭据，绝不提交）
recoverycode.txt

# 界面截图基线（本机对比用，node packages/preview/scripts/ui-shots.mjs 生成）
.ui-shots/
