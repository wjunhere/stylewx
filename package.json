{
  "name": "stylewx",
  "version": "0.1.2",
  "private": true,
  "description": "stylewx — 公众号排版 Agent 服务：无头排版内核 + MCP Server + REST API。让 AI Agent 根据文章自动选择/生成主题、渲染、校验并发布到微信公众号草稿箱。",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=2",
    "type-check": "turbo run type-check",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rimraf node_modules",
    "check:release": "node scripts/ci/verify-release.mjs",
    "check:pack": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" pack --pack-destination ./pack-out && node scripts/ci/verify-pack.mjs ./pack-out",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm type-check && pnpm test && pnpm check:release && pnpm check:pack && pnpm -r publish --no-git-checks --access public",
    "stylewx:editor": "node apps/mcp-server/scripts/editor.mjs",
    "brand:assets": "node scripts/brand/gen-brand-assets.mjs",
    "brand:contrast": "node scripts/brand/check-contrast.mjs",
    "brand:check": "node scripts/brand/check-editor.mjs --check && node scripts/brand/check-contrast.mjs --check",
    "stylewx:editor:http": "node apps/mcp-server/scripts/editor.mjs . 3777",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@stylewx/preview": "workspace:*",
    "@stylewx/publisher": "workspace:*",
    "@stylewx/service": "workspace:*",
    "@stylewx/theme": "workspace:*",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.5",
    "turbo": "^2.5.0",
    "typescript": "^5.7.2",
    "undici": "^8.10.2",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
